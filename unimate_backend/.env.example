# Database Configuration
DB_USERNAME=unimate_admin
DB_PASSWORD=admin123
DB_URL=jdbc:mysql://127.0.0.1:3306/unimate?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Docker (MySQL container) Configuration
# Used by `unimate_backend/docker-compose.yml` for local dev.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=unimate
MYSQL_USER=unimate_admin
MYSQL_PASSWORD=admin123

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Configuration
UPLOAD_PATH=./uploads/notes/

# Test Database Configuration (optional, for running tests)
TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/unimate_test?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
TEST_DB_USERNAME=unimate_admin
TEST_DB_PASSWORD=admin123
