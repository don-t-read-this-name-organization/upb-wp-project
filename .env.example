# UniMate Project Environment Configuration
# Copy this file to .env and fill in your values

# ====== Backend Configuration ======
# Database
DB_USERNAME=unimate_admin
DB_PASSWORD=admin123
DB_URL=jdbc:mysql://127.0.0.1:3306/unimate?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# JWT
JWT_SECRET_KEY=your-secret-key-here-change-in-production

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
UPLOAD_PATH=./uploads/notes/

# ====== Docker Configuration ======
# MySQL Configuration (used in docker-compose.yml)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=unimate
MYSQL_USER=unimate_admin
MYSQL_PASSWORD=admin123

# ====== Frontend Configuration ======
# API Server URL
VITE_API_SERVER=http://localhost:8888
